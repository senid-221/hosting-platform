DATABASE_URL="postgresql://hosting:hosting@localhost:5432/hosting"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_SECRET=""

PLATFORM_BASE_DOMAIN="apps.example.com"
PLATFORM_PUBLIC_PROTOCOL="https"
DOMAIN_VERIFICATION_MODE="production"
DOMAIN_VERIFICATION_HOST="_hosting"
DOMAIN_VERIFICATION_TTL=300

SECRETS_ENCRYPTION_KEY=""
STORAGE_ROOT="/var/lib/hosting-storage"

STORAGE_SIGNING_SECRET=""
STORAGE_PUBLIC_URL="/api/storage"
STORAGE_SIGNED_URL_TTL_SECONDS="300"
DEFAULT_STORAGE_GB="10"

BACKUP_STORAGE_ROOT="/var/lib/hosting-backups"
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS="30"

BILLING_CURRENCY="USD"

SCHEDULER_MAX_CPU_PERCENT="85"
SCHEDULER_MAX_MEMORY_PERCENT="0.85"
SCHEDULER_MAX_STORAGE_PERCENT="0.85"

NODE_BOOTSTRAP_TOKEN=""
NODE_AGENT_HEARTBEAT_SECONDS="30"

NODE_RUNTIME_MEMORY="768m"
NODE_RUNTIME_CPU="1.0"
NODE_BUILD_TIMEOUT_MS="600000"
NODE_AGENT_POLL_SECONDS="5"


# Node reverse proxy
NODE_RUNTIME_NETWORK="hosting-runtime"
CADDY_CONTAINER="hosting-caddy"
CADDYFILE_PATH="/var/lib/hosting-caddy/Caddyfile"
CADDYFILE_CONTAINER_PATH="/etc/caddy/Caddyfile"

# Node health protection
NODE_HEARTBEAT_TIMEOUT_SECONDS="90"
DEPLOYMENT_HEARTBEAT_TIMEOUT_SECONDS="120"
DEPLOYMENT_MAX_RETRIES="2"
NODE_DEGRADED_CPU_PERCENT="85"
NODE_DEGRADED_MEMORY_PERCENT="85"
NODE_DEGRADED_STORAGE_PERCENT="85"
NODE_HEALTHCHECK_TOKEN=""
NODE_AGENT_DEGRADED_CPU_PERCENT="85"
NODE_AGENT_DEGRADED_MEMORY_PERCENT="90"
NODE_AGENT_DISK_PATH="/"

# Deployment capacity reservations
SCHEDULER_MAX_CONCURRENT_DEPLOYMENTS="4"

NODE_RUNTIME_HEALTH_FAILURES="3"
NODE_RUNTIME_HEALTH_GRACE_SECONDS="30"

# Runtime auto-heal (read by the control plane, not the node agent)
RUNTIME_AUTO_HEAL_MAX_ATTEMPTS="3"
RUNTIME_AUTO_HEAL_WINDOW_MS="900000"

# Node health worker
NODE_HEALTH_RECONCILE_SECONDS="30"

# Deployment worker
DEPLOY_WORK_ROOT="/var/lib/hosting-builds"
DEPLOY_MEMORY="768m"
DEPLOY_CPU="1.0"
DEPLOY_CONCURRENCY="2"
DEPLOY_BUILD_TIMEOUT_MS="600000"
DEPLOYMENT_HEARTBEAT_INTERVAL_MS="30000"
